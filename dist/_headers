/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-3MKXq9ISshgJux6YwJca2+/lSN7bIT/acjiBQGsW7wA=' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; media-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
# Pages keep Cloudflare's default (revalidate every visit). Assets (5 Nov 2026): the old '/* no-cache' was joined onto these rules by
# Cloudflare, so fonts were revalidated on every navigation and the menu briefly showed a fallback font. Asset URLs carry ?v= hashes.
/assets/*
  Cache-Control: public, max-age=86400
# Preview and pages.dev addresses stay out of search engines (Cloudflare Pages host rules); premium-drones.ge is not affected.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
